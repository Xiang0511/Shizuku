@model Shizuku.ViewModels.ProductCreateDto

@{
    ViewData["Title"] = "新增產品";
}

<div class="container py-4">
    @* <!-- 頂部偽導航 -->
    <ul class="nav nav-tabs nav-tabs-shopee">
        <li class="nav-item"><a class="nav-link active" href="#">基本資訊</a></li>
        <li class="nav-item"><a class="nav-link" href="#">商品描述</a></li>
        <li class="nav-item"><a class="nav-link" href="#">銷售資訊</a></li>
        <li class="nav-item"><a class="nav-link" href="#">運費</a></li>
        <li class="nav-item"><a class="nav-link" href="#">其他</a></li>
    </ul> *@

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- 區塊一：基本資訊 -->
        <div class="shizuku-card">
            <h5 class="shizuku-section-title">基本資訊</h5>

            <div class="mb-4">
                <label class="form-label">商品圖片</label>
                <div class="d-flex align-items-start">
                    <div class="img-upload-box" onclick="document.getElementById('fPhotoInput').click()">
                        <i class="bi bi-image" style="font-size: 2rem; color: #ee4d2d;"></i>
                        <span style="font-size: 12px; color: #ee4d2d;">新增圖片</span>
                        <input asp-for="fPhoto" id="fPhotoInput" type="file" class="d-none" accept="image/*" onchange="previewImage(this)" />
                    </div>
                    <div id="imagePreviewContainer" class="ms-3 d-none">
                        <img id="imgPreview" src="#" style="width: 100px; height: 100px; object-fit: cover; border: 1px solid #ddd;" />
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size: 12px;">支援 jpg / png，建議比例 1:1</div>
            </div>

            <div class="row mb-3">
                <div class="col-md-8">
                    <label asp-for="fName" class="form-label">商品名稱</label>
                    <input asp-for="fName" class="form-control" placeholder="請輸入商品名稱" />
                    <span asp-validation-for="fName" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="fCategoryId" class="form-label">類別</label>
                    <select asp-for="fCategoryId" class="form-select" asp-items="ViewBag.fCategoryId">
                        <option value="">請選擇商品分類</option>
                    </select>
                    <span asp-validation-for="fCategoryId" class="text-danger"></span>
                </div>
            </div>
        </div>

        <!-- 區塊二：商品描述 -->
        <div class="shizuku-card">
            <h5 class="shizuku-section-title">商品描述</h5>
            <div class="mb-3">
                <label asp-for="fDescription" class="form-label">商品描述</label>
                <textarea asp-for="fDescription" class="form-control" rows="10" placeholder="請輸入詳細的商品說明..."></textarea>
                <span asp-validation-for="fDescription" class="text-danger"></span>
            </div>
        </div>

        <!-- 區塊三：銷售資訊 (規格與價格) -->
        <div class="shizuku-card">
            <h5 class="shizuku-section-title">銷售資訊</h5>
            <div class="row mt-3">
                <div class="col-md-4 mb-3">
                    <label asp-for="fColorId" class="form-label">顏色規格</label>
                    <select asp-for="fColorId" class="form-select" asp-items="ViewBag.fColorId">
                        <option value="">請選擇顏色</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="fSizeId" class="form-label">尺寸規格</label>
                    <select asp-for="fSizeId" class="form-select" asp-items="ViewBag.fSizeId">
                        <option value="">請選擇尺寸</option>
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="fPrice" class="form-label">價格</label>
                    <div class="input-group">
                        <span class="input-group-text">NT$</span>
                        <input asp-for="fPrice" class="form-control" placeholder="0" />
                    </div>
                    <span asp-validation-for="fPrice" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="fStock" class="form-label">庫存</label>
                    <input asp-for="fStock" class="form-control" type="number" placeholder="0" />
                    <span asp-validation-for="fStock" class="text-danger"></span>
                </div>
            </div>

          
        </div>

        <!-- 底部按鈕列 -->
        <div class="d-flex justify-content-end mb-5">
            <a asp-action="List" class="btn btn-outline-secondary me-3 px-5">取消</a>
            <button type="submit" class="btn btn-primary px-5" style="background-color:burlywood; border: none;">儲存並上架</button>
        </div>
    </form>
</div>
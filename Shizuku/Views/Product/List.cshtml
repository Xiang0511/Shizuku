@model IEnumerable<Shizuku.ViewModels.ProductListDto>

<style>
    .product-main-row { background-color: #f8f9fa; font-weight: bold; }
    .variant-row { background-color: #ffffff; border-left: 3px solid #dee2e6; }
    .product-img { object-fit: cover; border-radius: 4px; }
    .expand-btn { cursor: pointer; color: #0d6efd; text-decoration: none; }
</style>

<table class="table table-hover mt-3">
    <thead class="table-light">
        <tr>
            <th>商品細節</th>
            <th>價格</th>
            <th>總庫存</th>
            <th>狀態</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var collapseId = "variants_" + item.fId;
            
            <!-- 主商品行 -->
            <tr class="product-main-row">
                @* <td>
                    <button class="btn btn-sm btn-link expand-btn" type="button" 
                            data-bs-toggle="collapse" data-bs-target=".@collapseId">
                        ▶
                    </button>
                </td> *@
                <td>
                    <div class="d-flex align-items-center">
                        <img src="@(string.IsNullOrEmpty(item.fImage) ? "/images/no-image.png" : item.fImage)" 
                             width="60" height="60" class="product-img me-3" />
                        <div>
                            <div>@item.fName</div>
                            <small class="text-muted">貨號: @item.fProduct</small>
                        </div>
                    </div>
                </td>
                <td>NT$@item.fPrice.ToString("N0")</td>
                <td>@item.Variants.Sum(v => v.fStock)</td> @* 計算該商品總庫存 *@
                <td>
                    @if (item.fStatus == 1) { <span class="badge bg-success">上架中</span> }
                    else { <span class="badge bg-secondary">下架</span> }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.fId" class="btn btn-sm btn-outline-primary">編輯</a>
                </td>
            </tr>

            <!-- 規格明細行 (預設展開或隱藏) -->
            @foreach (var v in item.Variants)
            {
                <tr class="collapse show @collapseId variant-row">
                    <td></td>
                    <td class="ps-5">
                        <div class="d-flex align-items-center">
                            @* 如果規格有獨立圖可以在這裡顯示，沒有就縮排 *@
                            <span class="text-muted">規格：@v.fColor / @v.fSize</span>
                        </div>
                    </td>
                    <td class="text-muted">NT$@item.fPrice.ToString("N0")</td>
                    <td>
                        @if (v.fStock <= 0) { <span class="text-danger">已售完</span> }
                        else { <span>@v.fStock</span> }
                    </td>
                    <td></td>
                    <td></td>
                </tr>
            }

        }
    </tbody>
</table>